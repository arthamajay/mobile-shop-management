# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment files ────────────────────────────────────────────────────────
# Never commit real secrets — use .env.example as the template
.env
.env.local
.env.production
.env.staging

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ─── Generated / build output ────────────────────────────────────────────────
frontend/dist/
frontend/.vercel/

# ─── Generated PDFs (ephemeral, re-created at runtime) ───────────────────────
backend/uploads/pdfs/*.pdf

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
