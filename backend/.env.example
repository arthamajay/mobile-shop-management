# ─────────────────────────────────────────────────────────────────────────────
# Vamshi Store Manager — Backend Environment Variables
# Copy this file to .env and fill in every value before starting the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development          # Set to "production" on your server

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/mobileshop

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters; at least 64 recommended for production.
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend's origin in production (no trailing slash).
# Example: https://vamshi-store.example.com
FRONTEND_URL=http://localhost:3000

# ── WhatsApp Business API (optional) ─────────────────────────────────────────
# Leave as defaults to disable WhatsApp notifications.
# Replace with your provider's endpoint and token to enable them.
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_API_TOKEN=your_token_here

# ── Seed script (used only by scripts/seedAdmin.js) ──────────────────────────
# Set before running: SEED_ADMIN_PASSWORD=<password> node scripts/seedAdmin.js
# Optional overrides:
# SEED_ADMIN_EMAIL=admin@vamshistore.com
# SEED_ADMIN_NAME=Vamshi Admin
